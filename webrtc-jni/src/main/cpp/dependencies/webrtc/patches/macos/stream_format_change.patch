+bool AudioDeviceMac::ConfigureCaptureConverter(
+    const AudioStreamBasicDescription& input_format) {
+  if (input_format.mFormatID != kAudioFormatLinearPCM ||
+      input_format.mSampleRate == 0 ||
+      input_format.mChannelsPerFrame == 0 ||
+      input_format.mChannelsPerFrame > N_DEVICE_CHANNELS) {
+    RTC_LOG(LS_ERROR) << "Unsupported input stream format";
+    return false;
+  }
+
+  // Our preferred format to work with. Stereo recording needs both a stereo
+  // request and at least two channels on the device.
+  const bool stereo = input_format.mChannelsPerFrame >= 2 && _recChannels == 2;
+
+  AudioStreamBasicDescription desired_format;
+  memset(&desired_format, 0, sizeof(desired_format));
+  desired_format.mSampleRate = N_REC_SAMPLES_PER_SEC;
+  desired_format.mChannelsPerFrame = stereo ? 2 : 1;
+  desired_format.mBytesPerPacket =
+      desired_format.mChannelsPerFrame * sizeof(SInt16);
+  desired_format.mFramesPerPacket = 1;
+  desired_format.mBytesPerFrame =
+      desired_format.mChannelsPerFrame * sizeof(SInt16);
+  desired_format.mBitsPerChannel = sizeof(SInt16) * 8;
+
+  desired_format.mFormatFlags =
+      kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked;
+#ifdef WEBRTC_ARCH_BIG_ENDIAN
+  desired_format.mFormatFlags |= kLinearPCMFormatFlagIsBigEndian;
+#endif
+  desired_format.mFormatID = kAudioFormatLinearPCM;
+
+  // Create the converter before changing any state, so a failure leaves the
+  // previous formats and the previous converter consistent with each other.
+  AudioConverterRef capture_converter = NULL;
+  OSStatus err =
+      AudioConverterNew(&input_format, &desired_format, &capture_converter);
+  if (err != noErr) {
+    logCAMsg(LS_ERROR, "AudioConverterNew() failed", (const char*)&err);
+    return false;
+  }
+
+  if (!stereo) {
+    // Disable stereo recording when we only have one channel on the device.
+    _recChannels = 1;
+    RTC_LOG(LS_VERBOSE) << "Stereo recording unavailable on this device";
+  }
+
+  _inStreamFormat = input_format;
+  _inDesiredFormat = desired_format;
+
+  if (_ptrAudioBuffer) {
+    // Update audio buffer with the selected parameters.
+    _ptrAudioBuffer->SetRecordingSampleRate(N_REC_SAMPLES_PER_SEC);
+    _ptrAudioBuffer->SetRecordingChannels((uint8_t)_recChannels);
+  }
+
+  if (_captureConverter) {
+    WEBRTC_CA_LOG_WARN(AudioConverterDispose(_captureConverter));
+  }
+  _captureConverter = capture_converter;
+
+  return true;
+}
+
+int32_t AudioDeviceMac::UpdateCaptureLatency() {
+  OSStatus err = noErr;
+  UInt32 size = sizeof(UInt32);
+
+  // Get capture device latency
+  AudioObjectPropertyAddress propertyAddress = {
+      kAudioDevicePropertyLatency, kAudioDevicePropertyScopeInput, 0};
+  UInt32 latency = 0;
+  WEBRTC_CA_RETURN_ON_ERR(AudioObjectGetPropertyData(
+      _inputDeviceID, &propertyAddress, 0, NULL, &size, &latency));
+  UInt32 latency_us =
+      (UInt32)((1.0e6 * latency) / _inStreamFormat.mSampleRate);
+
+  // Get capture stream latency
+  propertyAddress.mSelector = kAudioDevicePropertyStreams;
+  AudioStreamID stream = 0;
+  size = sizeof(AudioStreamID);
+  WEBRTC_CA_RETURN_ON_ERR(AudioObjectGetPropertyData(
+      _inputDeviceID, &propertyAddress, 0, NULL, &size, &stream));
+  propertyAddress.mSelector = kAudioStreamPropertyLatency;
+  size = sizeof(UInt32);
+  latency = 0;
+  WEBRTC_CA_RETURN_ON_ERR(AudioObjectGetPropertyData(
+      _inputDeviceID, &propertyAddress, 0, NULL, &size, &latency));
+  latency_us += (UInt32)((1.0e6 * latency) / _inStreamFormat.mSampleRate);
+
+  _captureLatencyUs = latency_us;
+  return 0;
+}
+
+void AudioDeviceMac::DrainCaptureBuffer() {
+  // Only the capture worker reads `_captureBuffer`, so reading it empty here
+  // is safe against the IO proc writing to it concurrently. Bound the loop by
+  // what is buffered now, so a writer cannot keep it going.
+  size_t remaining = _captureBuffer.AvailableToRead();
+  while (remaining > 0) {
+    const size_t read = _captureBuffer.Read(std::span<Float32>(
+        _captureConvertData,
+        std::min<size_t>(remaining, REC_BUF_SIZE_IN_SAMPLES)));
+    if (read == 0) {
+      break;
+    }
+    remaining -= read;
+  }
+}
+
+void AudioDeviceMac::ApplyPendingCaptureFormat() {
+  if (!_captureFormatChangePending.load(std::memory_order_acquire)) {
+    return;
+  }
+
+  // The IO proc drops input while a change is pending, so what is still in
+  // the ring buffer was captured in the previous format. Discard it before
+  // clearing the flag, so the new converter never reads old-format samples
+  // and the channel interleaving cannot shift.
+  DrainCaptureBuffer();
+
+  AudioStreamBasicDescription format;
+  {
+    MutexLock lock(&_captureFormatMutex);
+    format = _pendingInStreamFormat;
+    _captureFormatChangePending.store(false, std::memory_order_release);
+  }
+
+  OSStatus err = noErr;
+
+  if (format.mSampleRate == _inStreamFormat.mSampleRate &&
+      format.mChannelsPerFrame == _inStreamFormat.mChannelsPerFrame &&
+      format.mBytesPerPacket == _inStreamFormat.mBytesPerPacket &&
+      format.mBytesPerFrame == _inStreamFormat.mBytesPerFrame &&
+      format.mBitsPerChannel == _inStreamFormat.mBitsPerChannel &&
+      format.mFormatFlags == _inStreamFormat.mFormatFlags &&
+      format.mFormatID == _inStreamFormat.mFormatID) {
+    // The converter may have been interrupted mid-conversion; reset it to
+    // match the drained ring buffer.
+    if (_captureConverter) {
+      WEBRTC_CA_LOG_WARN(AudioConverterReset(_captureConverter));
+    }
+    return;
+  }
+
+  RTC_LOG(LS_INFO) << "Applying capture stream format: sample_rate="
+                   << format.mSampleRate
+                   << ", channels=" << format.mChannelsPerFrame;
+
+  if (!ConfigureCaptureConverter(format)) {
+    // Keep capturing with the previous converter instead of stopping the
+    // worker. The stream is still better than no audio at all.
+    RTC_LOG(LS_ERROR) << "Failed to apply the new capture stream format";
+    return;
+  }
+
+  if (UpdateCaptureLatency() == -1) {
+    RTC_LOG(LS_WARNING) << "Failed to update the capture latency";
+  }
+}
