+bool AudioDeviceMac::ConfigureCaptureConverter(
+    const AudioStreamBasicDescription& input_format) {
+  if (input_format.mFormatID != kAudioFormatLinearPCM ||
+      input_format.mSampleRate == 0 ||
+      input_format.mChannelsPerFrame == 0 ||
+      input_format.mChannelsPerFrame > N_DEVICE_CHANNELS) {
+    RTC_LOG(LS_ERROR) << "Unsupported input stream format";
+    return false;
+  }
+
+  _inStreamFormat = input_format;
+
+  // Our preferred format to work with.
+  if (_inStreamFormat.mChannelsPerFrame >= 2 && (_recChannels == 2)) {
+    _inDesiredFormat.mChannelsPerFrame = 2;
+  } else {
+    // Disable stereo recording when we only have one channel on the device.
+    _inDesiredFormat.mChannelsPerFrame = 1;
+    _recChannels = 1;
+    RTC_LOG(LS_VERBOSE) << "Stereo recording unavailable on this device";
+  }
+
+  if (_ptrAudioBuffer) {
+    // Update audio buffer with the selected parameters.
+    _ptrAudioBuffer->SetRecordingSampleRate(N_REC_SAMPLES_PER_SEC);
+    _ptrAudioBuffer->SetRecordingChannels((uint8_t)_recChannels);
+  }
+
+  _inDesiredFormat.mSampleRate = N_REC_SAMPLES_PER_SEC;
+  _inDesiredFormat.mBytesPerPacket =
+      _inDesiredFormat.mChannelsPerFrame * sizeof(SInt16);
+  _inDesiredFormat.mFramesPerPacket = 1;
+  _inDesiredFormat.mBytesPerFrame =
+      _inDesiredFormat.mChannelsPerFrame * sizeof(SInt16);
+  _inDesiredFormat.mBitsPerChannel = sizeof(SInt16) * 8;
+
+  _inDesiredFormat.mFormatFlags =
+      kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked;
+#ifdef WEBRTC_ARCH_BIG_ENDIAN
+  _inDesiredFormat.mFormatFlags |= kLinearPCMFormatFlagIsBigEndian;
+#endif
+  _inDesiredFormat.mFormatID = kAudioFormatLinearPCM;
+
+  AudioConverterRef capture_converter = NULL;
+  OSStatus err = AudioConverterNew(&_inStreamFormat, &_inDesiredFormat,
+                                   &capture_converter);
+  if (err != noErr) {
+    logCAMsg(LS_ERROR, "AudioConverterNew() failed", (const char*)&err);
+    return false;
+  }
+
+  if (_captureConverter) {
+    WEBRTC_CA_LOG_WARN(AudioConverterDispose(_captureConverter));
+  }
+  _captureConverter = capture_converter;
+
+  return true;
+}
+
+void AudioDeviceMac::ApplyPendingCaptureFormat() {
+  AudioStreamBasicDescription format;
+  {
+    MutexLock lock(&_captureFormatMutex);
+    if (!_captureFormatChangePending.load(std::memory_order_acquire)) {
+      return;
+    }
+    format = _pendingInStreamFormat;
+    _captureFormatChangePending.store(false, std::memory_order_release);
+  }
+
+  if (format.mSampleRate == _inStreamFormat.mSampleRate &&
+      format.mChannelsPerFrame == _inStreamFormat.mChannelsPerFrame &&
+      format.mBytesPerPacket == _inStreamFormat.mBytesPerPacket &&
+      format.mBytesPerFrame == _inStreamFormat.mBytesPerFrame &&
+      format.mBitsPerChannel == _inStreamFormat.mBitsPerChannel &&
+      format.mFormatFlags == _inStreamFormat.mFormatFlags &&
+      format.mFormatID == _inStreamFormat.mFormatID) {
+    return;
+  }
+
+  RTC_LOG(LS_INFO) << "Applying capture stream format: sample_rate="
+                   << format.mSampleRate
+                   << ", channels=" << format.mChannelsPerFrame;
+
+  if (!ConfigureCaptureConverter(format)) {
+    // Keep capturing with the previous converter instead of stopping the
+    // worker. The stream is still better than no audio at all.
+    RTC_LOG(LS_ERROR) << "Failed to apply the new capture stream format";
+  }
+}
