+// A conversion of interleaved 16-bit audio from one channel count to
+// another, built from a channel mixing matrix. A matrix that only routes
+// channels becomes a channel map, and the samples are copied, as Chrome's
+// ChannelMixer does. Any other matrix becomes the list of non-zero terms of
+// each output channel, with integer coefficients, as Firefox's cubeb mixer
+// applies it to 16-bit audio.
+struct CoreAudioChannelConversion {
+  // Channels per input frame; 0 when there is nothing to convert.
+  size_t input_channels = 0;
+  // For a matrix that only routes channels: the input channel of each output
+  // channel, or -1 for silence. Empty otherwise.
+  std::vector<int> channel_map;
+  // For any other matrix: the (input channel, coefficient) pairs of each
+  // output channel, the coefficients in fixed point with 24 fractional bits.
+  std::vector<std::vector<std::pair<size_t, int32_t>>> terms;
+  // Whether a sum of terms can leave the 16-bit range, and must be clamped.
+  bool clipping = false;
+
+  bool empty() const { return input_channels == 0; }
+};
