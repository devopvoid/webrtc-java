+// Fractional bits of the fixed-point coefficients of a channel mix. Firefox's
+// cubeb mixer takes 15, which its 32-bit sums require. Sums here are 64-bit,
+// so they can take 24: a float coefficient from 1/2 to 1 fits them exactly,
+// a smaller one to within 2^-25, and a row of WebRTC's 7.1 downmix, which
+// sums to about 6, keeps the sum of full-scale input below 2^42.
+constexpr int kCoefficientBits = 24;
+
+// Returns the channel layout of a WASAPI format, mapping the speaker masks
+// the way Chrome's ChannelConfigToChannelLayout() does. A mask that is not
+// one of these, or that does not match the channel count, is treated as
+// discrete channels, which are copied by index.
+ChannelLayout WaveFormatToChannelLayout(const WAVEFORMATEX* format) {
+  ChannelLayout layout = GuessChannelLayout(format->nChannels);
+  if (format->wFormatTag == WAVE_FORMAT_EXTENSIBLE && format->cbSize >= 22) {
+    switch (
+        reinterpret_cast<const WAVEFORMATEXTENSIBLE*>(format)->dwChannelMask) {
+      case KSAUDIO_SPEAKER_MONO:
+        layout = CHANNEL_LAYOUT_MONO;
+        break;
+      case KSAUDIO_SPEAKER_STEREO:
+        layout = CHANNEL_LAYOUT_STEREO;
+        break;
+      case KSAUDIO_SPEAKER_QUAD:
+        layout = CHANNEL_LAYOUT_QUAD;
+        break;
+      case KSAUDIO_SPEAKER_SURROUND:
+        layout = CHANNEL_LAYOUT_4_0;
+        break;
+      case KSAUDIO_SPEAKER_5POINT1:
+        layout = CHANNEL_LAYOUT_5_1_BACK;
+        break;
+      case KSAUDIO_SPEAKER_5POINT1_SURROUND:
+        layout = CHANNEL_LAYOUT_5_1;
+        break;
+      case KSAUDIO_SPEAKER_7POINT1:
+        layout = CHANNEL_LAYOUT_7_1_WIDE;
+        break;
+      case KSAUDIO_SPEAKER_7POINT1_SURROUND:
+        layout = CHANNEL_LAYOUT_7_1;
+        break;
+      default:
+        break;
+    }
+  }
+  if (layout == CHANNEL_LAYOUT_UNSUPPORTED ||
+      ChannelLayoutToChannelCount(layout) != format->nChannels) {
+    layout = CHANNEL_LAYOUT_DISCRETE;
+  }
+  return layout;
+}
+
+// Builds the stream format for a device that accepts none of the formats
+// WebRTC asks for: 16-bit PCM in the channel count, speaker mask and sample
+// rate of the device's shared-mode mix format. The audio engine converts
+// 16-bit PCM to its float mix format itself, but not the channel count or
+// the rate, so these must match the mix format. Chrome and Firefox open such
+// devices the same way and convert the channels themselves. `conversion` gets
+// the conversion from `client_channels` to the device (render) or back
+// (capture), and stays empty when the channel counts match. Returns false if
+// the mix format cannot be used.
+bool MixFormatForClient(const WAVEFORMATEX* mix_format,
+                        uint16_t client_channels,
+                        bool render,
+                        WAVEFORMATEXTENSIBLE* format,
+                        CoreAudioChannelConversion* conversion) {
+  *conversion = CoreAudioChannelConversion();
+  // WebRTC exchanges audio in 10 ms blocks of whole frames.
+  if (mix_format->nChannels == 0 || mix_format->nSamplesPerSec % 100 != 0) {
+    return false;
+  }
+
+  *format = WAVEFORMATEXTENSIBLE();
+  format->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+  format->Format.nChannels = mix_format->nChannels;
+  format->Format.nSamplesPerSec = mix_format->nSamplesPerSec;
+  format->Format.wBitsPerSample = 16;
+  format->Format.nBlockAlign =
+      format->Format.nChannels * format->Format.wBitsPerSample / 8;
+  format->Format.nAvgBytesPerSec =
+      format->Format.nSamplesPerSec * format->Format.nBlockAlign;
+  format->Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+  format->Samples.wValidBitsPerSample = format->Format.wBitsPerSample;
+  format->SubFormat = KSDATAFORMAT_SUBTYPE_PCM;
+  if (mix_format->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+      mix_format->cbSize >= 22) {
+    format->dwChannelMask =
+        reinterpret_cast<const WAVEFORMATEXTENSIBLE*>(mix_format)
+            ->dwChannelMask;
+  }
+
+  if (format->Format.nChannels == client_channels) {
+    return true;
+  }
+
+  const ChannelLayout client_layout = GuessChannelLayout(client_channels);
+  const ChannelLayout device_layout =
+      WaveFormatToChannelLayout(&format->Format);
+  std::vector<std::vector<float>> matrix;
+  const bool remapping =
+      render ? ChannelMixingMatrix(client_layout, client_channels,
+                                   device_layout, format->Format.nChannels)
+                   .CreateTransformationMatrix(&matrix)
+             : ChannelMixingMatrix(device_layout, format->Format.nChannels,
+                                   client_layout, client_channels)
+                   .CreateTransformationMatrix(&matrix);
+  conversion->input_channels = matrix[0].size();
+  if (remapping) {
+    // Each output channel takes one input channel as it is, or none.
+    conversion->channel_map.assign(matrix.size(), -1);
+    for (size_t out = 0; out < matrix.size(); ++out) {
+      for (size_t in = 0; in < matrix[out].size(); ++in) {
+        if (matrix[out][in] > 0) {
+          conversion->channel_map[out] = static_cast<int>(in);
+          break;
+        }
+      }
+    }
+    return true;
+  }
+  conversion->terms.resize(matrix.size());
+  for (size_t out = 0; out < matrix.size(); ++out) {
+    int64_t sum = 0;
+    for (size_t in = 0; in < matrix[out].size(); ++in) {
+      const int32_t coefficient = static_cast<int32_t>(
+          std::lrintf(matrix[out][in] * (1 << kCoefficientBits)));
+      if (coefficient != 0) {
+        conversion->terms[out].emplace_back(in, coefficient);
+        sum += std::abs(coefficient);
+      }
+    }
+    // Full-scale input on every term would leave the 16-bit range.
+    if (sum > (int64_t{1} << kCoefficientBits)) {
+      conversion->clipping = true;
+    }
+  }
+  return true;
+}
+
+// Rounds a sum of terms to a 16-bit sample, as Firefox's cubeb mixer does,
+// and clamps it when `kClamp`.
+template <bool kClamp>
+int16_t RoundSum(int64_t sum) {
+  int64_t sample =
+      (sum + (int64_t{1} << (kCoefficientBits - 1))) >> kCoefficientBits;
+  if (kClamp) {
+    sample = std::clamp<int64_t>(sample, -32768, 32767);
+  }
+  return static_cast<int16_t>(sample);
+}
+
+// Mixes `frames` interleaved frames with the terms of `conversion`, one output
+// channel at a time and with loops for the usual numbers of terms, as
+// Firefox's cubeb mixer does.
+template <bool kClamp>
+void MixTerms(const CoreAudioChannelConversion& conversion,
+              const int16_t* input,
+              int16_t* output,
+              size_t frames) {
+  const size_t input_channels = conversion.input_channels;
+  const size_t output_channels = conversion.terms.size();
+  for (size_t out = 0; out < output_channels; ++out) {
+    const auto& terms = conversion.terms[out];
+    int16_t* dest = output + out;
+    switch (terms.size()) {
+      case 0:
+        for (size_t frame = 0; frame < frames; ++frame) {
+          dest[frame * output_channels] = 0;
+        }
+        break;
+      case 1: {
+        const int16_t* a = input + terms[0].first;
+        const int64_t ca = terms[0].second;
+        for (size_t frame = 0; frame < frames; ++frame) {
+          dest[frame * output_channels] =
+              RoundSum<kClamp>(ca * a[frame * input_channels]);
+        }
+        break;
+      }
+      case 2: {
+        const int16_t* a = input + terms[0].first;
+        const int16_t* b = input + terms[1].first;
+        const int64_t ca = terms[0].second;
+        const int64_t cb = terms[1].second;
+        for (size_t frame = 0; frame < frames; ++frame) {
+          dest[frame * output_channels] = RoundSum<kClamp>(
+              ca * a[frame * input_channels] + cb * b[frame * input_channels]);
+        }
+        break;
+      }
+      default:
+        for (size_t frame = 0; frame < frames; ++frame) {
+          const int16_t* in = input + frame * input_channels;
+          int64_t sum = 0;
+          for (const auto& [channel, coefficient] : terms) {
+            sum += int64_t{coefficient} * in[channel];
+          }
+          dest[frame * output_channels] = RoundSum<kClamp>(sum);
+        }
+        break;
+    }
+  }
+}
+
+// Converts `frames` interleaved frames with `conversion`: copies them by
+// channel when it only routes channels, and mixes them otherwise.
+void ConvertChannels(const CoreAudioChannelConversion& conversion,
+                     const int16_t* input,
+                     int16_t* output,
+                     size_t frames) {
+  if (!conversion.channel_map.empty()) {
+    const size_t output_channels = conversion.channel_map.size();
+    for (size_t frame = 0; frame < frames; ++frame) {
+      for (size_t out = 0; out < output_channels; ++out) {
+        const int in = conversion.channel_map[out];
+        *output++ = in < 0 ? 0 : input[in];
+      }
+      input += conversion.input_channels;
+    }
+  } else if (conversion.clipping) {
+    MixTerms<true>(conversion, input, output, frames);
+  } else {
+    MixTerms<false>(conversion, input, output, frames);
+  }
+}
