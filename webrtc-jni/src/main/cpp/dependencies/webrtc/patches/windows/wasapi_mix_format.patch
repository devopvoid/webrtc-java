+// Returns the channel layout of a WASAPI format, mapping the speaker masks
+// the way Chrome's ChannelConfigToChannelLayout() does. A mask that is not
+// one of these, or that does not match the channel count, is treated as
+// discrete channels, which are copied by index.
+ChannelLayout WaveFormatToChannelLayout(const WAVEFORMATEX* format) {
+  ChannelLayout layout = GuessChannelLayout(format->nChannels);
+  if (format->wFormatTag == WAVE_FORMAT_EXTENSIBLE && format->cbSize >= 22) {
+    switch (
+        reinterpret_cast<const WAVEFORMATEXTENSIBLE*>(format)->dwChannelMask) {
+      case KSAUDIO_SPEAKER_MONO:
+        layout = CHANNEL_LAYOUT_MONO;
+        break;
+      case KSAUDIO_SPEAKER_STEREO:
+        layout = CHANNEL_LAYOUT_STEREO;
+        break;
+      case KSAUDIO_SPEAKER_QUAD:
+        layout = CHANNEL_LAYOUT_QUAD;
+        break;
+      case KSAUDIO_SPEAKER_SURROUND:
+        layout = CHANNEL_LAYOUT_4_0;
+        break;
+      case KSAUDIO_SPEAKER_5POINT1:
+        layout = CHANNEL_LAYOUT_5_1_BACK;
+        break;
+      case KSAUDIO_SPEAKER_5POINT1_SURROUND:
+        layout = CHANNEL_LAYOUT_5_1;
+        break;
+      case KSAUDIO_SPEAKER_7POINT1:
+        layout = CHANNEL_LAYOUT_7_1_WIDE;
+        break;
+      case KSAUDIO_SPEAKER_7POINT1_SURROUND:
+        layout = CHANNEL_LAYOUT_7_1;
+        break;
+      default:
+        break;
+    }
+  }
+  if (layout == CHANNEL_LAYOUT_UNSUPPORTED ||
+      ChannelLayoutToChannelCount(layout) != format->nChannels) {
+    layout = CHANNEL_LAYOUT_DISCRETE;
+  }
+  return layout;
+}
+
+// Builds the stream format for a device that accepts none of the formats
+// WebRTC asks for: 16-bit PCM in the channel count, speaker mask and sample
+// rate of the device's shared-mode mix format. The audio engine converts
+// 16-bit PCM to its float mix format itself, but not the channel count or
+// the rate, so these must match the mix format. Chrome and Firefox open such
+// devices the same way and convert the channels themselves. `matrix` gets the
+// conversion from `client_channels` to the device (render) or back
+// (capture), and stays empty when the channel counts match. Returns false if
+// the mix format cannot be used.
+bool MixFormatForClient(const WAVEFORMATEX* mix_format,
+                        uint16_t client_channels,
+                        bool render,
+                        WAVEFORMATEXTENSIBLE* format,
+                        std::vector<std::vector<float>>* matrix) {
+  matrix->clear();
+  // WebRTC exchanges audio in 10 ms blocks of whole frames.
+  if (mix_format->nChannels == 0 || mix_format->nSamplesPerSec % 100 != 0) {
+    return false;
+  }
+
+  *format = WAVEFORMATEXTENSIBLE();
+  format->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+  format->Format.nChannels = mix_format->nChannels;
+  format->Format.nSamplesPerSec = mix_format->nSamplesPerSec;
+  format->Format.wBitsPerSample = 16;
+  format->Format.nBlockAlign =
+      format->Format.nChannels * format->Format.wBitsPerSample / 8;
+  format->Format.nAvgBytesPerSec =
+      format->Format.nSamplesPerSec * format->Format.nBlockAlign;
+  format->Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+  format->Samples.wValidBitsPerSample = format->Format.wBitsPerSample;
+  format->SubFormat = KSDATAFORMAT_SUBTYPE_PCM;
+  if (mix_format->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+      mix_format->cbSize >= 22) {
+    format->dwChannelMask =
+        reinterpret_cast<const WAVEFORMATEXTENSIBLE*>(mix_format)
+            ->dwChannelMask;
+  }
+
+  if (format->Format.nChannels == client_channels) {
+    return true;
+  }
+
+  const ChannelLayout client_layout = GuessChannelLayout(client_channels);
+  const ChannelLayout device_layout =
+      WaveFormatToChannelLayout(&format->Format);
+  if (render) {
+    ChannelMixingMatrix(client_layout, client_channels, device_layout,
+                        format->Format.nChannels)
+        .CreateTransformationMatrix(matrix);
+  } else {
+    ChannelMixingMatrix(device_layout, format->Format.nChannels, client_layout,
+                        client_channels)
+        .CreateTransformationMatrix(matrix);
+  }
+  return true;
+}
+
+// Converts `frames` interleaved frames with `matrix`, which has one row per
+// output channel and one column per input channel.
+void MixChannels(const std::vector<std::vector<float>>& matrix,
+                 const int16_t* input,
+                 int16_t* output,
+                 size_t frames) {
+  const size_t output_channels = matrix.size();
+  const size_t input_channels = matrix[0].size();
+  for (size_t frame = 0; frame < frames; ++frame) {
+    for (size_t out = 0; out < output_channels; ++out) {
+      float sample = 0.f;
+      for (size_t in = 0; in < input_channels; ++in) {
+        sample += matrix[out][in] * input[in];
+      }
+      *output++ = static_cast<int16_t>(
+          std::clamp(std::lrintf(sample), -32768l, 32767l));
+    }
+    input += input_channels;
+  }
+}
