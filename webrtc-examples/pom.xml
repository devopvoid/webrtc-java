<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.onvoid.webrtc</groupId>
        <artifactId>webrtc-java-parent</artifactId>
        <version>0.19.0-SNAPSHOT</version>
    </parent>

    <artifactId>webrtc-java-examples</artifactId>

    <name>webrtc-java-examples</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jetty.version>12.0.36</jetty.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <!-- Clear parent executions -->
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>17</release>
                        </configuration>
                    </execution>
                    <execution>
                        <id>base-compile</id>
                        <phase>none</phase>
                    </execution>
                </executions>
                <configuration>
                    <release>17</release>
                    <jdkToolchain>
                        <version>17</version>
                    </jdkToolchain>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <targetPath>resources</targetPath>
            </resource>
        </resources>
    </build>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>webrtc-java</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.websocket</groupId>
            <artifactId>jetty-websocket-jetty-server</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-util</artifactId>
            <version>${jetty.version}</version>
        </dependency>

        <!-- JSON Processing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.1</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.18</version>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            The media example needs webrtc-java-media, which is itself opt-in
            while it is being brought up on every platform, so it is built the
            same way and under the same profile name. Its source lives in a
            directory of its own, so that a build without the profile does not
            see it at all and an IDE does not report it as broken.

            It is compiled on its own, out of its own source directory and into
            an output directory of its own, rather than being added to the
            other examples. Those are a JPMS module, the example reads
            webrtc.java.media, and a "requires" cannot be made conditional:
            naming a module that is not there fails the whole compile. Keeping
            the example out of that source tree keeps its module descriptor off
            the sourcepath, so this compiles on the class path, which is how an
            example is run anyway. Once the media module builds on every
            platform and joins the reactor by default, all of this collapses
            into one dependency and one "requires".
        -->
        <profile>
            <id>with-media-extension</id>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-media-example</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <release>17</release>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/media/java</compileSourceRoot>
                                    </compileSourceRoots>
                                    <outputDirectory>${project.build.directory}/media-classes</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- The example is compiled apart from the others, so the
                         directory it lands in has to be named for a run to
                         find it. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/media-classes</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </plugin>
                </plugins>
            </build>

            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>webrtc-java-media</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>