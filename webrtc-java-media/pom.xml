<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>dev.onvoid.webrtc</groupId>
		<artifactId>webrtc-java-parent</artifactId>
		<version>0.19.0-SNAPSHOT</version>
	</parent>

	<artifactId>webrtc-java-media</artifactId>

	<name>webrtc-java-media</name>
	<description>
		Media extension for webrtc-java. Reads and decodes media files and network streams with
		FFmpeg and feeds them into a peer connection.
	</description>

	<properties>
		<!-- The FFmpeg release the third-party/ffmpeg submodule is pinned to. -->
		<ffmpeg.version>7.1.1</ffmpeg.version>
		<!-- Where the compiled FFmpeg libraries are installed and looked for. A
		     build reuses an existing install instead of building again, the way
		     the WebRTC checkout is reused. -->
		<ffmpeg.install.dir>${user.home}/ffmpeg/${platform.classifier}</ffmpeg.install.dir>
		<cmake.build.type>Release</cmake.build.type>
		<!-- Generator options, set per platform below. This module links only
		     against FFmpeg's C ABI and the JVM, never against WebRTC's C++
		     ABI, so it needs no special toolchain or standard library. -->
		<cmake.options />
		<cmake.config />
		<!-- A cross build needs a compiler for the target. Most targets here
		     use this module's own toolchain files rather than webrtc-jni's:
		     those compile with -nostdinc++ and link WebRTC's libc++, which
		     webrtc-jni needs to match WebRTC's C++ ABI and this module, which
		     links no C++ ABI at all, only inherits as a missing <string>. A
		     target built natively needs no file. -->
		<cmake.toolchain.file />
		<media.toolchain.dir>${project.basedir}/src/main/cpp/toolchain</media.toolchain.dir>
		<jni.toolchain.dir>${project.basedir}/../webrtc-jni/src/main/cpp/toolchain</jni.toolchain.dir>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Unlike webrtc, which resolves its natives as a jar
					     built by webrtc-jni, this module builds its own. At
					     test time they are not packaged yet, so the staging
					     directory the CMake build collects them into goes on
					     the class path instead: NativeLoader looks the
					     libraries up as class path resources, and a directory
					     serves them as well as a jar does. -->
					<additionalClasspathElements>
						<additionalClasspathElement>${project.build.directory}/natives</additionalClasspathElement>
					</additionalClasspathElements>
				</configuration>
			</plugin>

			<!-- Builds FFmpeg and the native media library for this platform. -->
			<plugin>
				<groupId>com.googlecode.cmake-maven-project</groupId>
				<artifactId>cmake-maven-plugin</artifactId>
				<version>3.31.5-b1</version>
				<executions>
					<execution>
						<id>cmake-generate</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<sourcePath>src/main/cpp</sourcePath>
							<targetPath>${project.build.directory}/${platform.classifier}</targetPath>
							<options>
								<option>
									"${cmake.options}"
								</option>
								<option>
									-DMEDIA_TOOLCHAIN_FILE=${cmake.toolchain.file}
								</option>
								<option>
									-DFFMPEG_INSTALL_DIR=${ffmpeg.install.dir}
								</option>
								<option>
									-DFFMPEG_VERSION=${ffmpeg.version}
								</option>
								<option>
									-DCMAKE_BUILD_TYPE=${cmake.build.type}
								</option>
								<option>
									-DOUTPUT_NAME_SUFFIX=${platform.classifier}
								</option>
							</options>
						</configuration>
					</execution>
					<execution>
						<id>cmake-compile</id>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<config>${cmake.config}</config>
							<projectDirectory>${project.build.directory}/${platform.classifier}</projectDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- The native library and the FFmpeg shared libraries go into a
			     jar of their own, one per platform, exactly as webrtc-java
			     ships its natives. The main jar stays platform independent. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<id>natives-jar</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>${platform.classifier}</classifier>
							<classesDirectory>${project.build.directory}/natives</classesDirectory>
							<archive>
								<manifestEntries>
									<FFmpeg-Version>${ffmpeg.version}</FFmpeg-Version>
									<FFmpeg-License>LGPL-2.1-or-later</FFmpeg-License>
								</manifestEntries>
							</archive>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!--
		The natives of this module are not a dependency of it. They are built
		and attached by this same module, so a dependency on them could not be
		resolved on the first build of a clean machine: nothing has produced
		them yet. webrtc-java can depend on its own classifier artifact only
		because webrtc-jni, an earlier module, is what builds it.

		Anything using this module therefore asks for the natives itself, with
		a second dependency carrying the platform classifier. The tests here
		need no such thing: Surefire is given the directory the CMake build
		collects them into.
	-->
	<dependencies>
		<dependency>
			<groupId>dev.onvoid.webrtc</groupId>
			<artifactId>webrtc-java</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<profiles>
		<!-- The platform profiles mirror webrtc-jni's, by name and by the
		     toolchain file each one selects, so that both native libraries of
		     a given classifier are built for the same target the same way. -->
		<profile>
			<id>linux-x86_64</id>
			<activation>
				<os>
					<family>linux</family>
					<arch>amd64</arch>
				</os>
			</activation>
			<!-- Built natively on an x86_64 runner, so the host compiler is
			     already the right one. -->
		</profile>
		<profile>
			<id>linux-aarch32</id>
			<activation>
				<os>
					<family>linux</family>
					<arch>aarch32</arch>
				</os>
			</activation>
			<properties>
				<cmake.toolchain.file>${media.toolchain.dir}/aarch32-linux.cmake</cmake.toolchain.file>
			</properties>
		</profile>
		<profile>
			<id>linux-aarch64</id>
			<activation>
				<os>
					<family>linux</family>
					<arch>aarch64</arch>
				</os>
			</activation>
			<properties>
				<cmake.toolchain.file>${media.toolchain.dir}/aarch64-linux.cmake</cmake.toolchain.file>
			</properties>
		</profile>
		<profile>
			<id>macos-aarch64</id>
			<activation>
				<os>
					<family>mac</family>
					<arch>aarch64</arch>
				</os>
			</activation>
			<!-- Both macOS targets build for the architecture Maven itself is
			     running as, the Intel one under "arch -x86_64", so neither is a
			     cross build and neither needs a toolchain file. -->
		</profile>
		<profile>
			<id>macos-cross-x86_64</id>
		</profile>

		<!-- Reruns the tests under -Xcheck:jni, which turns a JNI reference
		     mistake into a hard error instead of a crash somewhere later. Not
		     part of the default build: see the note in the root CLAUDE.md. -->
		<profile>
			<id>jni-check</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<!-- -Xcheck:jni writes straight to the process's
							     native stdout, which corrupts Surefire's
							     default pipe based fork protocol on that same
							     stream, so the fork talks over a socket. -->
							<forkNode implementation="org.apache.maven.plugin.surefire.extensions.SurefireForkNodeFactory" />
							<argLine>-Xcheck:jni</argLine>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>windows-x86_64</id>
			<activation>
				<os>
					<family>windows</family>
					<arch>amd64</arch>
				</os>
			</activation>
			<properties>
				<cmake.options>-Ax64</cmake.options>
				<cmake.config>${cmake.build.type}</cmake.config>
			</properties>
		</profile>
		<profile>
			<id>windows-aarch64</id>
			<properties>
				<cmake.options>-AARM64</cmake.options>
				<cmake.config>${cmake.build.type}</cmake.config>
				<cmake.toolchain.file>${jni.toolchain.dir}/aarch64-windows-clang.cmake</cmake.toolchain.file>
			</properties>
		</profile>
	</profiles>

</project>
